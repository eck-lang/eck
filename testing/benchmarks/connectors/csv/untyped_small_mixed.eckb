# Untyped CSV streaming over a small mixed file

Measures lazy untyped row streaming for 256 rows containing integer-looking,
text, and boolean-looking cells (header excluded). The loop counts rows without
materializing the source.

>>> prepare
python generate_data.py

>>> checkpoint lazy-csv 4789cddab3297ac9753fc94e0c4e64ca739b1c2f First buildable commit after lazy streaming CSV

>>> source
use CSV

let source = CSV.read("data/small_mixed.csv")
let rows = 0
for (row in source) {
    rows = rows + 1
}
print(rows)
