# Integer16 subtraction promotes mixed operands

Verifies int8 and int16 subtraction promotes to int16 while preserving the
source operand order.

>>> source
const narrow: int8 = 5
const wide: int16 = 10

const narrow_left: int16 = narrow - wide
const wide_left: int16 = wide - narrow
print(narrow_left)
print(wide_left)

<<< stdout
-5
5

<<< stderr
