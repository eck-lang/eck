# Integer16 multiplication promotes mixed operands

Verifies int8 and int16 multiplication in both operand orders produces an
int16 result.

>>> source
const narrow: int8 = 5
const wide: int16 = 10

const narrow_left: int16 = narrow * wide
const wide_left: int16 = wide * narrow
print(narrow_left)
print(wide_left)

<<< stdout
50
50

<<< stderr
