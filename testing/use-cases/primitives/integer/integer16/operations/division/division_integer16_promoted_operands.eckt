# Integer16 division promotes mixed operands

Verifies int8 and int16 division promotes to int16 and retains integer
truncation and source operand order.

>>> source
const narrow: int8 = 20
const wide: int16 = 5

const narrow_left: int16 = narrow / wide
const wide_left: int16 = wide / narrow
print(narrow_left)
print(wide_left)

<<< stdout
4
0

<<< stderr
