# Integer64 subtraction promotes signed overflow

Verifies that same-type subtraction widens an overflowing result to int128 and
continues to use the widened representation for a later subtraction.

>>> source
const near_minimum: int = -9223372036854775800
const minimum: int = near_minimum - 8
const unit: int = 1

const overflow: int = minimum - unit
print(overflow)

const continued: int = overflow - unit
print(continued)

<<< stdout
-9223372036854775809
-9223372036854775810

<<< stderr
