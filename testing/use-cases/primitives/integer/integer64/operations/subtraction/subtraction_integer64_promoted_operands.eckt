# Integer64 subtraction promotes mixed operands

Verifies every narrower signed integer width subtracts with int64 in both
operand orders, producing int64 while preserving order.

>>> source
const narrow8: int8 = 5
const narrow16: int16 = 5
const narrow32: int32 = 5
const wide: int64 = 10

const result8_left: int64 = narrow8 - wide
const result8_right: int64 = wide - narrow8
const result16_left: int64 = narrow16 - wide
const result16_right: int64 = wide - narrow16
const result32_left: int64 = narrow32 - wide
const result32_right: int64 = wide - narrow32
print(result8_left)
print(result8_right)
print(result16_left)
print(result16_right)
print(result32_left)
print(result32_right)

<<< stdout
-5
5
-5
5
-5
5

<<< stderr
