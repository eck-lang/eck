# Integer128 comparisons promote mixed operands

Verifies all comparison operators accept every narrower signed integer width
with int128 while preserving exact ordering.

>>> source
narrow8: int8 = 5
narrow16: int16 = 5
narrow32: int32 = 5
narrow64: int64 = 5
wide: int128 = 10

print(narrow8 < wide)
print(wide <= narrow16)
print(narrow32 > wide)
print(wide >= narrow64)
print(narrow16 == wide)
print(wide != narrow32)

<<< stdout
true
false
false
true
false
true

<<< stderr
