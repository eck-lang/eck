# Integer128 subtraction promotes mixed operands

Verifies every narrower signed integer width subtracts with int128 in both
operand orders, producing int128 while preserving order.

>>> source
narrow8: int8 = 5
narrow16: int16 = 5
narrow32: int32 = 5
narrow64: int64 = 5
wide: int128 = 10

result8_left: int128 = narrow8 - wide
result8_right: int128 = wide - narrow8
result16_left: int128 = narrow16 - wide
result16_right: int128 = wide - narrow16
result32_left: int128 = narrow32 - wide
result32_right: int128 = wide - narrow32
result64_left: int128 = narrow64 - wide
result64_right: int128 = wide - narrow64
print(result8_left)
print(result8_right)
print(result16_left)
print(result16_right)
print(result32_left)
print(result32_right)
print(result64_left)
print(result64_right)

<<< stdout
-5
5
-5
5
-5
5
-5
5

<<< stderr
