# Integer128 addition promotes mixed operands

Verifies every narrower signed integer width adds with int128 in both operand
orders and produces an int128 result.

>>> source
const narrow8: int8 = 5
const narrow16: int16 = 5
const narrow32: int32 = 5
const narrow64: int64 = 5
const wide: int128 = 10

const result8_left: int128 = narrow8 + wide
const result8_right: int128 = wide + narrow8
const result16_left: int128 = narrow16 + wide
const result16_right: int128 = wide + narrow16
const result32_left: int128 = narrow32 + wide
const result32_right: int128 = wide + narrow32
const result64_left: int128 = narrow64 + wide
const result64_right: int128 = wide + narrow64
print(result8_left)
print(result8_right)
print(result16_left)
print(result16_right)
print(result32_left)
print(result32_right)
print(result64_left)
print(result64_right)

<<< stdout
15
15
15
15
15
15
15
15

<<< stderr
