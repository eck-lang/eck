# Integer8 subtraction in both operand orders

Verifies int8 subtraction in both operand orders through the complete CLI
pipeline.

>>> source
const left: int8 = 100
const right: int8 = 27

// Verifies subtraction with the larger operand first.
const forward_diff: int8 = left - right
print(forward_diff)

// Verifies subtraction with the smaller operand first.
const reversed_diff: int8 = right - left
print(reversed_diff)

<<< stdout
73
-73

<<< stderr
