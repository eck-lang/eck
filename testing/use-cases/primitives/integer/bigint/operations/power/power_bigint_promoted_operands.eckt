# Bigint power promotes mixed operands

Verifies every narrower signed integer width exponentiates with bigint in
both operand orders and produces a bigint result. Raising 2 to the 10th
power yields 1024 whether the base or the exponent is the narrower
operand.

>>> source
const narrow8_base: int8 = 2
const narrow16_base: int16 = 2
const narrow32_base: int32 = 2
const narrow64_base: int64 = 2
const narrow128_base: int128 = 2
const wide_base: bigint = 2
const narrow8_exponent: int8 = 10
const narrow16_exponent: int16 = 10
const narrow32_exponent: int32 = 10
const narrow64_exponent: int64 = 10
const narrow128_exponent: int128 = 10
const wide_exponent: bigint = 10

const result8_left: bigint = narrow8_base ** wide_exponent
const result8_right: bigint = wide_base ** narrow8_exponent
const result16_left: bigint = narrow16_base ** wide_exponent
const result16_right: bigint = wide_base ** narrow16_exponent
const result32_left: bigint = narrow32_base ** wide_exponent
const result32_right: bigint = wide_base ** narrow32_exponent
const result64_left: bigint = narrow64_base ** wide_exponent
const result64_right: bigint = wide_base ** narrow64_exponent
const result128_left: bigint = narrow128_base ** wide_exponent
const result128_right: bigint = wide_base ** narrow128_exponent
print(result8_left)
print(result8_right)
print(result16_left)
print(result16_right)
print(result32_left)
print(result32_right)
print(result64_left)
print(result64_right)
print(result128_left)
print(result128_right)

<<< stdout
1024
1024
1024
1024
1024
1024
1024
1024
1024
1024

<<< stderr
