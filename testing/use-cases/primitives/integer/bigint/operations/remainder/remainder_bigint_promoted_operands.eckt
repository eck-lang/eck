# Bigint remainder promotes mixed operands

Verifies every narrower signed integer width takes the remainder with
bigint in both operand orders and produces a bigint result. The zero
remainders show the wider dividend is an exact multiple of the narrower
divisor.

>>> source
const narrow8: int8 = 5
const narrow16: int16 = 5
const narrow32: int32 = 5
const narrow64: int64 = 5
const narrow128: int128 = 5
const wide: bigint = 10

const result8_left: bigint = narrow8 % wide
const result8_right: bigint = wide % narrow8
const result16_left: bigint = narrow16 % wide
const result16_right: bigint = wide % narrow16
const result32_left: bigint = narrow32 % wide
const result32_right: bigint = wide % narrow32
const result64_left: bigint = narrow64 % wide
const result64_right: bigint = wide % narrow64
const result128_left: bigint = narrow128 % wide
const result128_right: bigint = wide % narrow128
print(result8_left)
print(result8_right)
print(result16_left)
print(result16_right)
print(result32_left)
print(result32_right)
print(result64_left)
print(result64_right)
print(result128_left)
print(result128_right)

<<< stdout
5
0
5
0
5
0
5
0
5
0

<<< stderr
