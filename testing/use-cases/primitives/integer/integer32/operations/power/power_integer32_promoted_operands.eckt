# Integer32 power promotes mixed operands

Verifies every narrower signed integer width participates in int32 power in
both operand orders and produces an int32 result.

>>> source
const narrow8: int8 = 2
const narrow16: int16 = 2
const wide: int32 = 3

const result8_base: int32 = narrow8 ** wide
const result8_exponent: int32 = wide ** narrow8
const result16_base: int32 = narrow16 ** wide
const result16_exponent: int32 = wide ** narrow16
print(result8_base)
print(result8_exponent)
print(result16_base)
print(result16_exponent)

<<< stdout
8
9
8
9

<<< stderr
