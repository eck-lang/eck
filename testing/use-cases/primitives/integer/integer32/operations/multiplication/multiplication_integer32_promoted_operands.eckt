# Integer32 multiplication promotes mixed operands

Verifies every narrower signed integer width multiplies with int32 in both
operand orders and produces an int32 result.

>>> source
const narrow8: int8 = 5
const narrow16: int16 = 5
const wide: int32 = 10

const result8_left: int32 = narrow8 * wide
const result8_right: int32 = wide * narrow8
const result16_left: int32 = narrow16 * wide
const result16_right: int32 = wide * narrow16
print(result8_left)
print(result8_right)
print(result16_left)
print(result16_right)

<<< stdout
50
50
50
50

<<< stderr
