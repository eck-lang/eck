# Integer32 division promotes mixed operands

Verifies every narrower signed integer width divides with int32 in both
operand orders, producing int32 with integer truncation.

>>> source
narrow8: int8 = 20
narrow16: int16 = 20
wide: int32 = 5

result8_left: int32 = narrow8 / wide
result8_right: int32 = wide / narrow8
result16_left: int32 = narrow16 / wide
result16_right: int32 = wide / narrow16
print(result8_left)
print(result8_right)
print(result16_left)
print(result16_right)

<<< stdout
4
0
4
0

<<< stderr
