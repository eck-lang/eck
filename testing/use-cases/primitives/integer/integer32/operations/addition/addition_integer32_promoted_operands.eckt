# Integer32 addition promotes mixed operands

Verifies every narrower signed integer width adds with int32 in both operand
orders and produces an int32 result.

>>> source
narrow8: int8 = 5
narrow16: int16 = 5
wide: int32 = 10

result8_left: int32 = narrow8 + wide
result8_right: int32 = wide + narrow8
result16_left: int32 = narrow16 + wide
result16_right: int32 = wide + narrow16
print(result8_left)
print(result8_right)
print(result16_left)
print(result16_right)

<<< stdout
15
15
15
15

<<< stderr
