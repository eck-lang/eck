# Float subtraction with integer operands

Subtracts 1.5 from 7 in both operand orders to verify the integer is
promoted and the result stays a float whose sign follows the operand
order, producing 5.5 and -5.5.

>>> source
const integer_left: int = 7
const float_left: float = 1.5

// Verifies the Int-to-Float promotion.
const integer_minus_float: float = integer_left - float_left
print(integer_minus_float)

// Verifies the same promotion with the operand order reversed.
const float_minus_integer: float = float_left - integer_left
print(float_minus_integer)

<<< stdout
5.5
-5.5

<<< stderr
