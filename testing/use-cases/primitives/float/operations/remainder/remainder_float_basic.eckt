# Float remainder of float operands

Takes 10.5 modulo 3 to verify the fractional remainder, producing 1.5.
A negative dividend verifies the remainder keeps the dividend sign,
producing -1.5.

>>> source
dividend: float = 10.5
divisor: float = 3
negative_dividend: float = -10.5

// Verifies the remainder of two positive floats.
positive_remainder: float = dividend % divisor
print(positive_remainder)

// Verifies the remainder takes the dividend sign.
negative_remainder: float = negative_dividend % divisor
print(negative_remainder)

<<< stdout
1.5
-1.5

<<< stderr
