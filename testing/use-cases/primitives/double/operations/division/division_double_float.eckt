# Double division with float operands

Divides 3.0 by 1.5 and 2.25 by 3.0 with the types swapped between float
and double to verify the float operand is promoted and the result stays
a double, producing 2 and 0.75.

>>> source
const float_value: float = 3.0
const double_value: double = 1.5
const double_dividend: double = 2.25
const float_divisor: float = 3.0

const float_divided_by_double: double = float_value / double_value
print(float_divided_by_double)

// Verifies the same promotion with the operand order reversed.
const double_divided_by_float: double = double_dividend / float_divisor
print(double_divided_by_float)

<<< stdout
2
0.75

<<< stderr
