# Double power with float operands

Raises a float 2.0 to a double 2.0 power and a double 2.25 to a float 1.5
power to verify the float operand is promoted and the result stays a
double, producing 4 and 3.375.

>>> source
float_base: float = 2.0
double_exponent: double = 2.0
double_base: double = 2.25
float_exponent: float = 1.5

power: double = float_base ** double_exponent
print(power)

// Verifies the same promotion with the operand order reversed.
reversed_power: double = double_base ** float_exponent
print(reversed_power)

<<< stdout
4
3.375

<<< stderr
