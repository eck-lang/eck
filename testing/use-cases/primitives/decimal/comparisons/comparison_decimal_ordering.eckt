# Decimal comparison ordering

Verifies the decimal equality and ordering relations through the complete
CLI pipeline. Every operand is decimal: comparisons are only defined between
equal types.

>>> source
const low: decimal = 1.25
const high: decimal = 2.5
const same: decimal = 2.5

// Verifies the equality family on equal and distinct operands.
print(high == same)
print(low == high)

// Verifies the ordering family on distinct operands.
print(low < high)
print(high < low)
print(high >= same)
print(low >= high)

<<< stdout
true
false
true
false
true
false

<<< stderr
