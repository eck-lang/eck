# Decimal subtraction with double operands

Subtracts 2.25 from 2.30 in both operand orders to verify the f64 value
converts into an exact decimal result whose sign follows the operand
order, producing 0.05 and -0.05.

>>> source
const double_right: double = 2.25
const decimal_left: decimal = 2.30

// Verifies the Decimal/Double conversion.
const decimal_minus_double: decimal = decimal_left - double_right
print(decimal_minus_double)

// Verifies the same conversion with the operand order reversed.
const double_minus_decimal: decimal = double_right - decimal_left
print(double_minus_decimal)

<<< stdout
0.05
-0.05

<<< stderr
