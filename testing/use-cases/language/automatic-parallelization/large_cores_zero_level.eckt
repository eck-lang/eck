# Large core counts are independent of the level scale

A 100000-core budget is accepted while level 0 keeps an independent array transform sequential and preserves its result.

>>> source
@config { parallelization: { cores: 100000
level: 0 } }
let output: int[] = [0,0,0,0]
const input: int[] = [1,2,3,4]
for (i in 0..4) { output[i] = input[i] * 2 }
print(output)

<<< stdout
[2, 4, 6, 8]

<<< stderr
